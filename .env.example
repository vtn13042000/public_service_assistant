# Copy to .env (git-ignored) and fill the CHANGEME values. infra/langfuse/up.sh generates a filled .env if none exists.
# No cloud API keys are needed anywhere in this project (R6).

# --- Local models (src/llm.py) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# APP_GENERATOR_MODEL=qwen3.5   # generator + classifier (draft_answer, assess_need); qwen3.6 for variant guardrailed_v2_q36. Old name APP_LLM_MODEL still read.
# APP_JUDGE_MODEL=qwen3.6
# APP_EMBED_MODEL=bge-m3

# --- App data ---
APP_DB=data/app.db

# --- LangFuse client (src/tracing.py) ---
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_HOST=http://127.0.0.1:3000      # deprecated alias, kept for older tools
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME

# --- LangFuse server headless init (infra/langfuse/docker-compose.yml) ---
LANGFUSE_INIT_ORG_ID=ai5013
LANGFUSE_INIT_ORG_NAME=AI5013
LANGFUSE_INIT_PROJECT_ID=ai5013-psa
LANGFUSE_INIT_PROJECT_NAME=public-services-assistant
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME      # must equal LANGFUSE_PUBLIC_KEY
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME      # must equal LANGFUSE_SECRET_KEY
LANGFUSE_INIT_USER_EMAIL=admin@ai5013.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# --- LangFuse server secrets ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME_64_hex_chars                  # openssl rand -hex 32
POSTGRES_PASSWORD=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME

# --- Web search (src/tools/web.py) ---
# APP_WEB_BACKEND=searxng,duckduckgo,bing
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_SECRET=CHANGEME                               # infra/searxng/up.sh appends a random one to .env
